#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <4>;
        rows = <7>;
        map = <
    RC(0,0) RC(0,1) RC(0,2) RC(0,3)
    RC(1,0) RC(1,1) RC(1,2) RC(1,3)
    RC(2,0) RC(2,1) RC(2,2)
    RC(3,0) RC(3,1) RC(3,2) RC(3,3)
    RC(4,0) RC(4,1) RC(4,2) RC(4,3)
    /* Cloned Row 0 on Backup Pin 100 (pro_micro 6) */
    RC(5,0) RC(5,1) RC(5,2) RC(5,3)
    /* Cloned Row 0 on Backup Pin 009 (pro_micro 10) */
    RC(6,0) RC(6,1) RC(6,2) RC(6,3)
        >;
    };
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";

        diode-direction = "col2row";
        row-gpios
            = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Row 0: Original Pin 031 / A0 */
            , <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Row 1: Pin 029 / A1 */
            , <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Row 2: Pin 002 / A2 */
            , <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Row 3: Pin 111 / MISO (anteriormente 115) */
            , <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Row 4: Pin 010 / MOSI (anteriormente 113) */
            , <&pro_micro 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Row 5: Backup Pin 100 / D6 (Clone of Row 0) */
            , <&pro_micro 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Row 6: Backup Pin 009 / D10 (Clone of Row 0) */
            ;
    };
};
